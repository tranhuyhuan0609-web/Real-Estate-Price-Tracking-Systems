# Copy to .env and fill in the passwords. .env is git-ignored; never commit real credentials.

# Host ports exposed by Docker Compose (16100-16105 belong to the previous version)
KAFKA_HOST_PORT=17100
KAFKA_UI_HOST_PORT=17101
MONGO_HOST_PORT=17102
POSTGRES_HOST_PORT=17103

# MongoDB (connecting from the host machine)
# Inside Docker containers use MONGO_HOST=mongo and MONGO_PORT=27017
MONGO_HOST=127.0.0.1
MONGO_PORT=17102
MONGO_USER=huyhuan
MONGO_PASSWORD=change_me
MONGO_DB=Property_data

# PostgreSQL (connecting from the host machine)
# Inside Docker containers use POSTGRES_HOST=postgres and POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=17103
POSTGRES_USER=huyhuan
POSTGRES_PASSWORD=change_me
POSTGRES_DB=Property_data

# Kafka (connecting from the host machine)
# Inside Docker containers use KAFKA_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:17100
KAFKA_RAW_TOPIC=Property_data.raw_events
KAFKA_DLQ_TOPIC=Property_data.dlq_events
KAFKA_GROUP_BRONZE=bds_bronze_mongo_groups
KAFKA_GROUP_SILVER_GOLD=bds_silver_gold_pg_groups
KAFKA_GROUP_RAW_WRITER=bds_bronze_mongo_groups
KAFKA_GROUP_CLEAN_PROCESSOR=bds_silver_gold_pg_groups
KAFKA_GROUP_DLQ_WRITER=bds_dlq_writer_groups
CRAWLER_LOG_LEVEL=INFO

# Telegram alerts (filled in on day 19)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
